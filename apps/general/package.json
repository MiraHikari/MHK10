{
  "name": "@mhk/general",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "fonts:subset": "python scripts/subset-harmonyos.py",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:sync": "node --env-file-if-exists=.env scripts/sync-images.mjs",
    "typecheck": "astro sync && tsc --noEmit",
    "check": "astro check && tsc --noEmit",
    "test": "vp test",
    "astro": "astro",
    "lint": "vp lint",
    "verify:architecture": "node --test scripts/verify-architecture.test.mjs && node scripts/verify-architecture.mjs",
    "verify:site": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@giscus/react": "^3.1.0",
    "@mhk/site-core": "*",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.3.5",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "yaml": "^2.8.3",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/compiler-rs": "0.5.1",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.92",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite-plus": "1.0.0"
  },
  "packageManager": "npm@11.9.0"
}
