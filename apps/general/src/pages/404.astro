---
import Layout from '@/layouts/Layout.astro';
import { pageTitle } from '@/lib/page-title';
import '@/styles/global.css';
import '@/styles/pages/not-found.css';
---

<Layout
  title={pageTitle(['404'])}
  description="页面不存在，返回首页看看别的 (┬┬﹏┬┬)"
  noindex
  minimalBoot
>
  <main id="main-content" tabindex="-1" class="not-found" aria-labelledby="not-found-title">
    <section class="not-found__panel">
      <p class="not-found__eyebrow">// HTTP::404</p>
      <h1 id="not-found-title" class="not-found__code">
        404
      </h1>
      <p class="not-found__message">command not found: {Astro.url.pathname}</p>
      <a href="/" class="not-found__button" data-cursor="HOME">
        RETURN HOME
      </a>
    </section>
  </main>
</Layout>
