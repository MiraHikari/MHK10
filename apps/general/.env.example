# ---- 站点公开源（构建用规范 origin）----
# 用于 sitemap、robots、canonical 链接等；生产环境设为通用站真实域名
# 未设置时回退到 example.com 占位 origin
PUBLIC_SITE_ORIGIN=https://www.example.com

# ---- 图片 CDN（访客只读地址）----
# 渲染层把所有 /images/* 路径拼接到该基座；留空则回退到同源 public/images（本地开发可用）
# 部署时在托管项目中设置这个公共构建变量；R2 管理密钥只用于本地同步与后台上传
PUBLIC_IMAGE_BASE_URL=https://static.example.com

# ---- 访客统计（可选）----
# 自托管 Open Kounter 服务基座；留空需自行配置计数服务地址
#PUBLIC_KOUNTER_URL=https://kounter.example.com

# ---- Giscus 评论（可选覆盖；默认使用 packages/site-core/src/config/giscus.ts 的共享配置）----
# 在 https://giscus.app 生成后填入；仓库需安装 giscus GitHub App
#PUBLIC_GISCUS_REPO=owner/blog-comments
#PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxxxx
#PUBLIC_GISCUS_CATEGORY=Announcements
#PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxxxxxxxxx_xxxx

# ---- R2 S3 管理凭据（本地 apps/general/scripts/sync-images.mjs 与 /admin 后台直传使用）----
# endpoint 为 virtual-hosted 风格（已内嵌 account 与 bucket），具备 admin 权限
R2_ENDPOINT=https://<bucket>.<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ---- Win95 融合桌面（独立部署的桌面站，托管项目单独配置）----
# iframe 全屏嵌入的桌面站地址。留空（默认）→ Win95 模式整体旁路，站点恒为经典形态。
# 本地联调示例：PUBLIC_DESK_URL=http://localhost:4322
PUBLIC_DESK_URL=https://mhk10.example.com
