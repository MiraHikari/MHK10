---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page not found"
  description="This address could not be found. Return to the desktop to explore the gallery and journal."
  lang="en"
  noindex
>
  <main class="page-shell error-page">
    <section aria-labelledby="error-title">
      <p class="error-code">ERROR 404 / FILE NOT FOUND</p>
      <h1 id="error-title">
        This folder
        <br />
        is empty.
      </h1>
      <p>
        The page may have moved, or the address may contain a typo.
        <br />
        Return to the desktop or open another folder.
      </p>
      <nav aria-label="Continue exploring">
        <a href="/">Desktop</a>
        <a href="/blog/">Journal</a>
        <a href="/gallery/">Gallery</a>
      </nav>
    </section>
  </main>
</SiteLayout>

<style>
  .error-page {
    padding-block: clamp(3rem, 10vw, 8rem);
  }
  section {
    max-width: 780px;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 6px 6px 0 var(--line);
    padding: clamp(1.5rem, 5vw, 3rem);
  }
  .error-code {
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1.25;
    letter-spacing: -0.04em;
  }
  p {
    line-height: 1.9;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
  a {
    display: inline-block;
    border: 1px solid var(--ink);
    padding: 0.7rem 1rem;
    font-weight: 700;
  }
</style>
