---
import { iconUrl } from '../lib/gfx/app-icon-art';
interface Props {
  name: string;
  size?: number;
  label?: string;
}
const { name, size = 24, label } = Astro.props;
---

<img
  class="pixel-icon"
  src={iconUrl(name, size)}
  width={size}
  height={size}
  alt={label ?? ''}
  aria-hidden={label ? undefined : 'true'}
/>
<style>
  .pixel-icon {
    display: inline-block;
    flex: 0 0 auto;
    object-fit: contain;
    image-rendering: pixelated;
    vertical-align: middle;
  }
</style>
