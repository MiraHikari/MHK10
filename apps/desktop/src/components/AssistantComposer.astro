<form class="assistant-compose" data-assistant-composer hidden aria-label="Assistant message">
  <div class="compose-tools">
    <fieldset class="compose-route">
      <legend class="compose-live">Send to</legend>
      <label>
        <input type="radio" name="destination" value="guide" checked />
        <span>Desktop guide</span>
      </label>
      <label>
        <input type="radio" name="destination" value="online" disabled />
        <span data-online-label>Online</span>
      </label>
    </fieldset>
    <button type="button" data-action="guide" aria-expanded="false" aria-controls="assistant-guide">
      Guide
    </button>
    <button type="button" data-action="log" aria-expanded="false" aria-controls="assistant-log">
      Log
    </button>
    <button type="button" data-action="connection">
      Connection
    </button>
  </div>
  <div class="compose-message">
    <label for="assistant-message">Message</label>
    <input
      id="assistant-message"
      name="message"
      type="text"
      enterkeyhint="send"
      autocomplete="off"
    />
    <button type="submit" data-action="send">
      Send
    </button>
    <button type="button" data-action="stop" hidden>
      Stop
    </button>
  </div>
  <section class="compose-panel" id="assistant-guide" aria-label="Offline guide" hidden>
    <strong>Desktop guide</strong>
    <span>Always offline</span>
    <div data-prompts></div>
  </section>
  <section class="compose-panel" id="assistant-log" aria-label="Conversation log" hidden>
    <strong>Conversation log</strong>
    <span>This session</span>
    <div class="compose-history" tabindex="0" data-history></div>
  </section>
  <span class="compose-live" role="status" aria-atomic="true"></span>
</form>

<style>
