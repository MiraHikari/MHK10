# Copy to .env and adjust as needed. All variables are optional — the site
# builds with sensible defaults when they are absent.

# Canonical public origin of this desktop presentation, used for the Astro
# `site`, sitemap and robots output. Unset falls back to an example.com
# placeholder origin (see src/data/site-origin.ts).
PUBLIC_SITE_ORIGIN=https://mhk10.example.com

# Image CDN base (R2). Display WebP copies and VGA previews stay local under
# /images/; camera originals resolve here for ACDSee downloads. Unset keeps
# local original paths, which exist only if hydrated manually (see
# docs/portfolio-source.md). See src/data/images.ts.
PUBLIC_IMAGE_BASE_URL=https://static.example.com

# Self-hosted Open Kounter visit counter. Unset disables remote visit counting
# (see src/lib/kounter.ts).
#PUBLIC_KOUNTER_URL=https://kounter.example.com

# Giscus comment configuration overrides (optional). Unset uses the shared
# config in packages/site-core/src/config/giscus.ts. Generate the values at
# https://giscus.app; the target repository must have the giscus GitHub App
# installed.
#PUBLIC_GISCUS_REPO=owner/blog-comments
#PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxxxx
#PUBLIC_GISCUS_CATEGORY=Announcements
#PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxxxxxxxxx_xxxx

# Origin of the parent page when this site runs embedded with ?shell=full.
# postMessage from the embed host is targeted at this origin only.
PUBLIC_PARENT_ORIGIN=https://www.example.com
# Multiple exact trusted parents (comma or space separated); overrides the legacy setting.
#PUBLIC_PARENT_ORIGINS=https://www.example.com
# General presentation destination for independently opened desktop pages.
PUBLIC_GENERAL_URL=https://www.example.com
